# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env — ele está no .gitignore.

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DBNAME=postgres
PG_SSLMODE=disable

# ── Autenticação ───────────────────────────────────────────────────────────────
# Mínimo 32 caracteres aleatórios — nunca use o valor abaixo em produção
JWT_SECRET=
JWT_EXPIRATION_HOURS=8

# ── Google Gemini AI ───────────────────────────────────────────────────────────
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
# Configure via variável de ambiente do servidor — NUNCA insira a chave aqui em texto claro
GEMINI_API_KEY=
